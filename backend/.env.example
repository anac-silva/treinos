NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://personal:CHANGE_ME@localhost:5432/personal?schema=public
POSTGRES_USER=personal
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=personal
CORS_ORIGINS=http://localhost:5173
SESSION_TTL_HOURS=12
# Só para desenvolvimento neste computador; mantém a API limitada a localhost.
LOCAL_AUTH_BYPASS=false
# Em produção use uma origem HTTPS e configure somente o proxy confiável.
TRUST_PROXY=false
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=
PHOTO_STORAGE=disabled
# Para bucket privado S3 ou compatível: PHOTO_STORAGE=s3
S3_BUCKET=
S3_REGION=
# Opcional para storage compatível. Em produção deve usar HTTPS.
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
# Preferir role da infraestrutura; se usar variáveis, preencher só no ambiente real.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
