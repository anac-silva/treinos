generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  singleton          Int       @unique @default(1) @db.SmallInt
  name               String    @db.VarChar(100)
  email              String    @unique @db.VarChar(254)
  passwordHash       String
  mustChangePassword Boolean   @default(true)
  active             Boolean   @default(true)
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(3)
  lastLoginAt        DateTime? @db.Timestamptz(3)
  sessions           Session[]
  corrections        AssessmentCorrection[]
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  PRE_REGISTERED
}

enum AppointmentStatus {
  PENDING_CONFIRMATION
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum WorkoutLevel {
  BASIC
  INTERMEDIATE
  ADVANCED
}

model Client {
  id              String       @id @default(uuid()) @db.Uuid
  name            String       @db.VarChar(100)
  age             Int?
  heightCm        Decimal?     @db.Decimal(6, 2)
  sex             String?      @db.VarChar(10)
  email           String?      @db.VarChar(254)
  phone           String?      @db.VarChar(40)
  goal            String?      @db.VarChar(100)
  experienceLevel String?      @db.VarChar(50)
  notes           String?
  status          ClientStatus @default(ACTIVE)
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(3)
  assessments     Assessment[]
  photos          ClientPhoto[]
  appointments    Appointment[]
  workouts        WorkoutPlan[]
  workoutSheets   WorkoutSheet[]

  @@index([status, name])
}

model Exercise {
  id        String            @id @default(uuid()) @db.Uuid
  name      String            @db.VarChar(100)
  nameKey   String            @unique @db.VarChar(100)
  createdAt DateTime          @default(now()) @db.Timestamptz(3)
  workouts  WorkoutExercise[]

  @@index([name])
}

model WorkoutPlan {
  id           String            @id @default(uuid()) @db.Uuid
  clientId     String?           @db.Uuid
  client       Client?           @relation(fields: [clientId], references: [id], onDelete: Restrict)
  sourcePlanId String?           @db.Uuid
  sheetId      String?           @db.Uuid
  sheet        WorkoutSheet?     @relation(fields: [sheetId], references: [id], onDelete: Restrict)
  position     Int               @default(0)
  focus        String?           @db.VarChar(100)
  sourcePlan   WorkoutPlan?      @relation("WorkoutCopies", fields: [sourcePlanId], references: [id], onDelete: SetNull)
  copies       WorkoutPlan[]     @relation("WorkoutCopies")
  title        String            @db.VarChar(100)
  level        WorkoutLevel
  notes        String?
  isActive     Boolean           @default(false)
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)
  exercises    WorkoutExercise[]

  @@index([clientId, isActive, createdAt])
  @@index([level, createdAt])
  @@unique([sheetId, position])
}

model WorkoutSheet {
  id            String         @id @default(uuid()) @db.Uuid
  clientId      String?        @db.Uuid
  client        Client?        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  title         String         @db.VarChar(100)
  notes         String?
  isActive      Boolean        @default(false)
  sourceSheetId String?        @db.Uuid
  sourceSheet   WorkoutSheet?   @relation("SheetCopies", fields: [sourceSheetId], references: [id], onDelete: SetNull)
  copies        WorkoutSheet[]  @relation("SheetCopies")
  blocks        WorkoutPlan[]
  createdAt     DateTime        @default(now()) @db.Timestamptz(3)

  @@index([clientId, isActive, createdAt])
}

model WorkoutExercise {
  id            String      @id @default(uuid()) @db.Uuid
  workoutPlanId String      @db.Uuid
  workoutPlan   WorkoutPlan @relation(fields: [workoutPlanId], references: [id], onDelete: Cascade)
  exerciseId    String      @db.Uuid
  exercise      Exercise    @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  position      Int
  sets          Int
  repetitions   String      @db.VarChar(40)
  restSeconds   Int?
  notes         String?

  @@unique([workoutPlanId, position])
  @@index([exerciseId])
}

model Appointment {
  id              String            @id @default(uuid()) @db.Uuid
  clientId        String?           @db.Uuid
  client          Client?           @relation(fields: [clientId], references: [id], onDelete: Restrict)
  sourceAssessmentId String?        @unique @db.Uuid
  sourceAssessment Assessment?      @relation(fields: [sourceAssessmentId], references: [id], onDelete: Restrict)
  guestName       String?           @db.VarChar(100)
  guestPhone      String?           @db.VarChar(40)
  startsAt        DateTime          @db.Timestamptz(3)
  durationMinutes Int               @default(60)
  type            String            @db.VarChar(100)
  notes           String?
  status          AppointmentStatus @default(SCHEDULED)
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(3)

  @@index([startsAt, status])
  @@index([clientId, startsAt])
}

model MeasurementType {
  id           String                  @id @default(uuid()) @db.Uuid
  name         String                  @db.VarChar(100)
  nameKey      String                  @unique @db.VarChar(100)
  unit         String                  @db.VarChar(20)
  active       Boolean                 @default(true)
  createdAt    DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime                @updatedAt @db.Timestamptz(3)
  measurements AssessmentMeasurement[]
}

model Assessment {
  id               String                  @id @default(uuid()) @db.Uuid
  clientId         String                  @db.Uuid
  client           Client                  @relation(fields: [clientId], references: [id], onDelete: Restrict)
  assessedOn       DateTime                @db.Date
  weightKg         Decimal                 @db.Decimal(7, 3)
  heightCm         Decimal?                @db.Decimal(6, 2)
  bodyFatPercent   Decimal?                @db.Decimal(5, 2)
  notes            String?
  nextAssessmentOn DateTime?               @db.Date
  version          Int                     @default(1)
  createdAt        DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime                @updatedAt @db.Timestamptz(3)
  measurements     AssessmentMeasurement[]
  corrections      AssessmentCorrection[]
  nextAppointment  Appointment?

  @@index([clientId, assessedOn, createdAt])
}

model AssessmentMeasurement {
  id            String          @id @default(uuid()) @db.Uuid
  assessmentId  String          @db.Uuid
  assessment    Assessment      @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  typeId        String          @db.Uuid
  type          MeasurementType @relation(fields: [typeId], references: [id], onDelete: Restrict)
  typeName      String          @db.VarChar(100)
  unit          String          @db.VarChar(20)
  value         Decimal         @db.Decimal(10, 3)

  @@unique([assessmentId, typeId])
  @@index([typeId, assessmentId])
}

model AssessmentCorrection {
  id           String     @id @default(uuid()) @db.Uuid
  assessmentId String     @db.Uuid
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  actorId      String     @db.Uuid
  actor        User       @relation(fields: [actorId], references: [id], onDelete: Restrict)
  reason       String     @db.VarChar(500)
  version      Int
  before       Json
  after        Json
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)

  @@unique([assessmentId, version])
}

model ClientPhoto {
  id         String   @id @default(uuid()) @db.Uuid
  clientId   String   @db.Uuid
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  storageKey String   @unique
  mimeType   String   @db.VarChar(50)
  sizeBytes  Int
  principal  Boolean  @default(true)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([clientId, principal])
}

model Session {
  id            String    @id @default(uuid()) @db.Uuid
  tokenHash     String    @unique @db.Char(64)
  csrfTokenHash String    @db.Char(64)
  userId        String    @db.Uuid
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt     DateTime  @db.Timestamptz(3)
  revokedAt     DateTime? @db.Timestamptz(3)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}
